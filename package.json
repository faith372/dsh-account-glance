{
  "name": "dsh-account-glance",
  "version": "1.3.0",
  "description": "DSH Web GUI sidebar glance card: DeepSeek account balance, the current peak / off-peak billing period with a countdown, and today's spend / tokens / calls, seated directly above the account row.",
  "license": "MIT",
  "author": "Faith372",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "sidebar",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faith372/dsh-account-glance.git"
  },
  "homepage": "https://github.com/faith372/dsh-account-glance#readme",
  "bugs": {
    "url": "https://github.com/faith372/dsh-account-glance/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "verify": "node test/verify.mjs"
  }
}
